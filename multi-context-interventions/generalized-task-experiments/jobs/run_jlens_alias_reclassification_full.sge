#!/bin/bash -l
#$ -P buinlp
#$ -N jl_alias_full
#$ -cwd
#$ -j y
#$ -o /projectnb/buinlp/rathin/composition-experiments/multi-context-interventions/generalized-task-experiments/logs
#$ -pe omp 2
#$ -l gpus=1
#$ -l gpu_type=A40|A100|L40S|A6000
#$ -l h_rt=01:00:00
#$ -t 1-28
#$ -tc 4

set -euo pipefail

module load python3/3.12.4

readonly EXPERIMENT_DIR="/projectnb/buinlp/rathin/composition-experiments/multi-context-interventions/generalized-task-experiments"
readonly CODE_DIR="$EXPERIMENT_DIR/code"
readonly RESULTS_DIR="$EXPERIMENT_DIR/results"
readonly PYTHON_BIN="/projectnb/buinlp/rathin/influence-composition/.venv/bin/python"
readonly JLENS_DIR="/projectnb/buinlp/rathin/composition-experiments/JLens"
readonly LENS_PATH="$JLENS_DIR/results/fit_1000/merged/jacobian_lens.pt"
readonly RUNNER="$CODE_DIR/jlens_alias_reclassification/evaluate_aliases.py"
readonly SHARD_SIZE=50

# The merged J-Lens files contain 940 landmark and 419 park shortcut rows.
# Array tasks 1--19 cover landmark; tasks 20--28 cover park.
if (( SGE_TASK_ID <= 19 )); then
    readonly TASK_NAME="landmark-country-capital"
    readonly TOTAL_SHORTCUTS=940
    readonly LOCAL_SHARD_INDEX=$((SGE_TASK_ID - 1))
else
    readonly TASK_NAME="park-country-capital"
    readonly TOTAL_SHORTCUTS=419
    readonly LOCAL_SHARD_INDEX=$((SGE_TASK_ID - 20))
fi

readonly START_INDEX=$((LOCAL_SHARD_INDEX * SHARD_SIZE))
REMAINING=$((TOTAL_SHORTCUTS - START_INDEX))
if (( REMAINING <= 0 )); then
    echo "Array task is outside the declared shortcut population" >&2
    exit 2
fi
if (( REMAINING < SHARD_SIZE )); then
    readonly COUNT=$REMAINING
else
    readonly COUNT=$SHARD_SIZE
fi

readonly INPUT="$RESULTS_DIR/$TASK_NAME/jlens_evaluation.jsonl.gz"
readonly SHARD_DIR="$RESULTS_DIR/jlens_alias_reclassification/$TASK_NAME/shards"
printf -v SHARD_ID "%06d" "$START_INDEX"
readonly OUTPUT="$SHARD_DIR/alias_reclassification_${SHARD_ID}.jsonl.gz"
readonly SUMMARY="$SHARD_DIR/alias_reclassification_${SHARD_ID}_summary.json"

for path in "$PYTHON_BIN" "$RUNNER" "$INPUT" "$LENS_PATH"; do
    test -r "$path"
done
test ! -e "$OUTPUT"
test ! -e "$SUMMARY"
mkdir -p "$SHARD_DIR"

export CPATH="$SCC_PYTHON3_INCLUDE/python3.12${CPATH:+:$CPATH}"
export PYTHONPATH="$CODE_DIR:$JLENS_DIR/environment:$JLENS_DIR/vendor/jacobian-lens${PYTHONPATH:+:$PYTHONPATH}"
export HF_HOME="/projectnb/buinlp/rathin/influence-composition/.cache/huggingface"
export HF_DATASETS_OFFLINE=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=2 MKL_NUM_THREADS=2

echo "task=$TASK_NAME shortcut_start=$START_INDEX count=$COUNT total=$TOTAL_SHORTCUTS"
"$PYTHON_BIN" "$RUNNER" \
    --task "$TASK_NAME" \
    --input "$INPUT" \
    --lens "$LENS_PATH" \
    --output "$OUTPUT" \
    --summary-output "$SUMMARY" \
    --start-index "$START_INDEX" \
    --num-records "$COUNT" \
    --progress-every 10
