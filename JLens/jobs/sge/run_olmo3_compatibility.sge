#!/bin/bash -l
#$ -clear
#$ -P buinlp
#$ -N olmo3_jlens_check
#$ -cwd
#$ -j y
#$ -o /projectnb/buinlp/rathin/composition-experiments/JLens/results/logs
#$ -pe omp 4
#$ -l gpus=1
#$ -l gpu_type=A40|A100|L40|L40S|A6000

# Verify that the authors' unmodified HF adapter correctly wraps the pinned
# OLMo 3 stage-one checkpoint. This performs two short forward passes only; it
# does not calculate Jacobians or fit a lens. There is no explicit time limit.
set -euo pipefail
module load python3/3.12.4

readonly ROOT="/projectnb/buinlp/rathin/composition-experiments/JLens"
readonly PYTHON_BIN="/projectnb/buinlp/rathin/influence-composition/.venv/bin/python"
readonly HF_CACHE_ROOT="/projectnb/buinlp/rathin/influence-composition/.cache/huggingface"
readonly REPORT="$ROOT/results/compatibility/olmo3_stage1.json"
readonly EXPECTED_JLENS_COMMIT="581d398613e5602a5af361e1c34d3a92ea82ba8e"

cd "$ROOT"

test -x "$PYTHON_BIN"
test -d "$ROOT/environment"
test -r "$ROOT/src/jlens_experiments/compatibility.py"
test -d "$ROOT/vendor/jacobian-lens/.git"
test -d "$HF_CACHE_ROOT/hub"

if [[ -e "$REPORT" ]]; then
    printf 'Compatibility report already exists; refusing to overwrite it.\n' >&2
    exit 1
fi

actual_jlens_commit="$(git -C "$ROOT/vendor/jacobian-lens" rev-parse HEAD)"
if [[ "$actual_jlens_commit" != "$EXPECTED_JLENS_COMMIT" ]]; then
    printf 'Unexpected J-lens commit: %s\n' "$actual_jlens_commit" >&2
    exit 1
fi

export CPATH="$SCC_PYTHON3_INCLUDE/python3.12${CPATH:+:$CPATH}"
export PYTHONPATH="$ROOT/environment:$ROOT/vendor/jacobian-lens:$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
export HF_HOME="$HF_CACHE_ROOT"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS="${NSLOTS:-4}"
export MKL_NUM_THREADS="${NSLOTS:-4}"

printf 'OLMo 3 J-lens compatibility: job=%s slots=%s\n' \
    "${JOB_ID:-unknown}" "${NSLOTS:-unknown}"
date -u '+Started: %Y-%m-%d %H:%M:%S UTC'
nvidia-smi
"$PYTHON_BIN" - <<'PY'
import torch
import transformers
print("torch", torch.__version__, "cuda", torch.version.cuda)
print("transformers", transformers.__version__)
PY
sha256sum \
    "$ROOT/src/jlens_experiments/compatibility.py" \
    "$ROOT/requirements-overlay.txt"

"$PYTHON_BIN" -m jlens_experiments.compatibility --report "$REPORT"

date -u '+Finished: %Y-%m-%d %H:%M:%S UTC'
