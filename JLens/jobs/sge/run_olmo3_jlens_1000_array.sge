#!/bin/bash -l
#$ -clear
#$ -P buinlp
#$ -N olmo3_jlens_1k
#$ -cwd
#$ -j y
#$ -o /projectnb/buinlp/rathin/composition-experiments/JLens/results/logs
#$ -pe omp 4
#$ -l mem_per_core=12G
#$ -l gpus=1
#$ -l gpu_type=A40|A100|L40|L40S|A6000
#$ -t 1-10
#$ -tc 10

# Fit ten independent 100-prompt J-Lens shards. Each array task reads a fixed,
# non-overlapping slice of the same 1,000-prompt manifest. There is deliberately
# no explicit wall-clock limit.
set -euo pipefail
module load python3/3.12.4

readonly ROOT="/projectnb/buinlp/rathin/composition-experiments/JLens"
readonly PYTHON_BIN="/projectnb/buinlp/rathin/influence-composition/.venv/bin/python"
readonly HF_CACHE_ROOT="/projectnb/buinlp/rathin/influence-composition/.cache/huggingface"
readonly MANIFEST="$ROOT/results/fit_1000/prompt_manifest.jsonl"
readonly EXPECTED_MANIFEST_SHA="a6ae0cfada1e54f29c94f294c0d6b755871d2cbc07d4b2672acb8ce5f71bc0d6"
readonly EXPECTED_JLENS_COMMIT="581d398613e5602a5af361e1c34d3a92ea82ba8e"
readonly NUM_SHARDS=10
readonly SHARD_INDEX=$((SGE_TASK_ID - 1))
printf -v SHARD_NAME 'shard_%02d' "$SHARD_INDEX"
readonly OUTPUT_DIR="$ROOT/results/fit_1000/shards/$SHARD_NAME"

cd "$ROOT"
test -x "$PYTHON_BIN"
test -d "$ROOT/environment"
test -r "$ROOT/src/jlens_experiments/fit_jlens.py"
test -d "$ROOT/vendor/jacobian-lens/.git"
test -d "$HF_CACHE_ROOT/hub"
test -r "$MANIFEST"
mkdir -p "$OUTPUT_DIR" "$ROOT/results/logs"

# Checkpoints and shard prompt files are allowed because interrupted tasks
# resume. A final lens or summary means that shard has already completed.
if [[ -e "$OUTPUT_DIR/jacobian_lens.pt" || -e "$OUTPUT_DIR/summary.json" ]]; then
    printf 'Completed output already exists for %s; refusing to overwrite it.\n' \
        "$SHARD_NAME" >&2
    exit 1
fi

actual_manifest_sha="$(sha256sum "$MANIFEST" | awk '{print $1}')"
if [[ "$actual_manifest_sha" != "$EXPECTED_MANIFEST_SHA" ]]; then
    printf 'Unexpected prompt-manifest SHA-256: %s\n' "$actual_manifest_sha" >&2
    exit 1
fi

actual_jlens_commit="$(git -C "$ROOT/vendor/jacobian-lens" rev-parse HEAD)"
if [[ "$actual_jlens_commit" != "$EXPECTED_JLENS_COMMIT" ]]; then
    printf 'Unexpected J-Lens commit: %s\n' "$actual_jlens_commit" >&2
    exit 1
fi

export CPATH="$SCC_PYTHON3_INCLUDE/python3.12${CPATH:+:$CPATH}"
export PYTHONPATH="$ROOT/environment:$ROOT/vendor/jacobian-lens:$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
export HF_HOME="$HF_CACHE_ROOT"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS="${NSLOTS:-4}"
export MKL_NUM_THREADS="${NSLOTS:-4}"

printf 'OLMo 3 J-Lens 1k fit: job=%s task=%s shard=%s slots=%s\n' \
    "${JOB_ID:-unknown}" "${SGE_TASK_ID:-unknown}" "$SHARD_INDEX" \
    "${NSLOTS:-unknown}"
date -u '+Started: %Y-%m-%d %H:%M:%S UTC'
nvidia-smi
"$PYTHON_BIN" - <<'PY'
import torch
import transformers
print("torch", torch.__version__, "cuda", torch.version.cuda)
print("transformers", transformers.__version__)
PY
sha256sum \
    "$ROOT/src/jlens_experiments/fit_jlens.py" \
    "$ROOT/src/jlens_experiments/manifest.py" \
    "$ROOT/requirements-overlay.txt" \
    "$MANIFEST"

"$PYTHON_BIN" -m jlens_experiments.fit_jlens \
    --prompt-manifest "$MANIFEST" \
    --num-shards "$NUM_SHARDS" \
    --shard-index "$SHARD_INDEX" \
    --output-dir "$OUTPUT_DIR" \
    --max-seq-len 128 \
    --layers 12 16 18 20 22 24 \
    --target-layer 31 \
    --dim-batch 8 \
    --checkpoint-every 10

date -u '+Finished: %Y-%m-%d %H:%M:%S UTC'
